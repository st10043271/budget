<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Page Title -->
        <TextView
            android:id="@+id/expenseSelectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Your Expenses"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            tools:ignore="HardcodedText" />

        <!-- Fixed Expenses Section -->
        <TextView
            android:id="@+id/fixedExpensesLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fixed Expenses"
            android:textColor="#FF4081"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <!-- Fixed Expenses List -->
        <LinearLayout
            android:id="@+id/fixedExpensesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/expense_box"
            android:padding="10dp">

            <CheckBox
                android:id="@+id/rentCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rent"
                android:textColor="#FFFFFF"/>

            <CheckBox
                android:id="@+id/utilityCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Utilities"
                android:textColor="#FFFFFF"/>

            <CheckBox
                android:id="@+id/insuranceCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Insurance"
                android:textColor="#FFFFFF"/>

            <CheckBox
                android:id="@+id/carPaymentCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Car Payment"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- Subscription Expenses Section -->
        <TextView
            android:id="@+id/subscriptionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Subscription Expenses"
            android:textColor="#FF4081"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"/>

        <!-- Subscription Expenses List with Date Pickers -->
        <LinearLayout
            android:id="@+id/subscriptionContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/expense_box"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <CheckBox
                    android:id="@+id/netflixCheckBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Netflix"
                    android:textColor="#FFFFFF"
                    android:layout_weight="1"/>

                <Button
                    android:id="@+id/netflixDateButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pick Date"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#FF4081"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <CheckBox
                    android:id="@+id/spotifyCheckBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Spotify"
                    android:textColor="#FFFFFF"
                    android:layout_weight="1"/>

                <Button
                    android:id="@+id/spotifyDateButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pick Date"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#FF4081"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <CheckBox
                    android:id="@+id/amazonCheckBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Amazon Prime"
                    android:textColor="#FFFFFF"
                    android:layout_weight="1"/>

                <Button
                    android:id="@+id/amazonDateButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pick Date"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#FF4081"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Continue Button -->
        <Button
            android:id="@+id/continueButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Continue"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF4081"
            android:layout_marginTop="24dp"/>
    </LinearLayout>
</ScrollView>
