<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Logo at the top -->
        <ImageView
            android:id="@+id/logoImageView"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/logo"
            android:contentDescription="App Logo"
            android:layout_marginBottom="24dp" />

        <!-- Income Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Monthly Income"
            android:textColor="#FF69B4"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/editTextIncome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter your income"
            android:inputType="numberDecimal"
            android:textColor="#FFFFFF"
            android:textColorHint="#FF69B4"
            android:backgroundTint="#FF69B4"
            android:layout_marginBottom="16dp" />

        <!-- Two-column Layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="24dp">

            <!-- Fixed Expenses Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fixed Expenses"
                    android:textColor="#FF69B4"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/editTextFixedLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Expense Name"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#FF69B4"
                    android:backgroundTint="#FF69B4" />

                <EditText
                    android:id="@+id/editTextFixedAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Amount"
                    android:inputType="numberDecimal"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#FF69B4"
                    android:backgroundTint="#FF69B4"
                    android:layout_marginTop="4dp" />

                <Button
                    android:id="@+id/buttonAddFixedExpense"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#FF69B4"
                    android:layout_marginTop="8dp" />

                <LinearLayout
                    android:id="@+id/fixedExpenseList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Subscription Expenses Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Subscription Expenses"
                    android:textColor="#FF69B4"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/editTextSubscriptionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Subscription Name"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#FF69B4"
                    android:backgroundTint="#FF69B4" />

                <EditText
                    android:id="@+id/editTextSubscriptionAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Amount"
                    android:inputType="numberDecimal"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#FF69B4"
                    android:backgroundTint="#FF69B4"
                    android:layout_marginTop="4dp" />

                <Button
                    android:id="@+id/buttonAddSubscription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#FF69B4"
                    android:layout_marginTop="8dp" />

                <LinearLayout
                    android:id="@+id/subscriptionExpenseList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Preview of Savings -->
        <TextView
            android:id="@+id/textViewSavingsPreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Savings: --"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <!-- Save / Continue Button -->
        <Button
            android:id="@+id/buttonSaveAndContinue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save and Continue"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF69B4"
            android:layout_marginBottom="24dp" />
    </LinearLayout>
</ScrollView>