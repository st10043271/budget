<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Your other layout elements go here -->

                <ImageView
                    android:id="@+id/logoImage"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="-5dp"
                    android:layout_marginEnd="146dp"
                    android:contentDescription="App Logo"
                    android:src="@drawable/logo"
                    tools:ignore="HardcodedText" />

                <!-- Real-time Sync Indicator -->
                <androidx.core.widget.CircularProgressIndicator
                    android:id="@+id/syncIndicator"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_centerInParent="true"
                    android:indeterminate="true"
                    android:visibility="gone"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginBottom="80dp"
                    tools:ignore="MissingClass" />

            </RelativeLayout>

            <!-- App Title -->

            <!-- Spending Summary -->
            <TextView
                android:id="@+id/appTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="FinScope"
                android:textColor="#FF69B4"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:padding="16dp"
                android:background="@drawable/rounded_container"
                android:elevation="4dp">


            <TextView
                    android:id="@+id/spentText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R 0.00 spent"
                    android:textSize="18sp"
                    android:textColor="#FF69B4"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/spentDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="since you stuffed last, today"
                    android:textSize="14sp"
                    android:textColor="#AAAAAA"
                    android:layout_marginTop="4dp"
                    tools:ignore="HardcodedText" />

                <!-- Progress Bar -->
                <ProgressBar
                    android:id="@+id/spendingProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:progress="20"
                    android:progressTint="#FF69B4"
                    android:layout_marginTop="8dp" />

                <!-- Category Legends -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• variable "
                        android:textColor="#FF69B4"
                        android:textSize="12sp"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• fixed "
                        android:textColor="#FF9999"
                        android:textSize="12sp"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• saving "
                        android:textColor="#FFCCCC"
                        android:textSize="12sp"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• spent"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>
            </LinearLayout>

            <!-- Variable Envelopes -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Variable Envelopes"
                android:textSize="18sp"
                android:textColor="#FF69B4"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                tools:ignore="HardcodedText" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnEntertainment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎭 Entertainment\nR 0.00"
                    android:textColor="#FFFFFF"
                    android:background="#333333"
                    android:padding="12dp"
                    android:elevation="4dp"
                    tools:ignore="ButtonStyle,HardcodedText" />

                <Button
                    android:id="@+id/btnDiningOut"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🍽️ Dining Out\nR 30.00"
                    android:textColor="#FFFFFF"
                    android:background="#333333"
                    android:padding="12dp"
                    android:layout_marginStart="8dp"
                    android:elevation="4dp"
                    tools:ignore="ButtonStyle,HardcodedText" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Floating Action Button to Add New Expense -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_expense"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:backgroundTint="#FF69B4"
        android:src="@android:drawable/ic_input_add"
        app:fabSize="normal"
        tools:ignore="ContentDescription,SpeakableTextPresentCheck" />

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:menu="@menu/bottom_nav_menu"
        android:background="#222222"
        app:itemIconTint="@color/white"
        app:itemTextColor="@color/white"
        tools:ignore="VisualLintBottomNav" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
